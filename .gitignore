# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Sanal ortamlar
venv/
.venv/
env/
ENV/

# Test ve tip denetimi önbellekleri
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml

# --- Node / frontend ---
# Ayrıntılı kurallar frontend/.gitignore içinde; buradakiler yedek amaçlıdır.
node_modules/
frontend/dist/

# --- Ortam değişkenleri ---
# Gizli değer taşıyabilecek dosyalar depoya girmemelidir.
.env
.env.*
.env.local

# İki istisna vardır ve ikisi de yalnızca herkese açık bilgi taşır:
#   .env.example    — hangi değişkenlerin bulunduğunu belgeler
#   .env.production — yayına alınmış frontend'in bağlanacağı API adresi
# Vite'ın `VITE_` önekli değişkenleri derleme sırasında paketin içine gömülür;
# yani tarayıcıya inen koddan zaten okunabilirler. Bu nedenle bu dosyalara
# **hiçbir zaman** gizli anahtar yazılmamalıdır — gizli olması gereken her şey
# backend tarafında kalmalıdır.
!.env.example
!.env.production

# --- Editör ve işletim sistemi ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
