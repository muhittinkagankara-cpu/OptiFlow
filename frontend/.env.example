# Yerelde varsayilan degerleri degistirmek isterseniz bu dosyayi `.env.local`
# olarak kopyalayin. Deger verilmezse arayuz http://127.0.0.1:8000 adresini
# kullanir.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Kimlik dogrulama (Faz 2). Ikisi de Supabase panelinde Project Settings ->
# API altinda bulunur. `VITE_SUPABASE_ANON_KEY` bir sir DEGILDIR — Supabase'in
# tasarimi geregi tarayiciya acikca gonderilmek uzere uretilir; gercek
# yetkilendirme backend'de JWT dogrulamasi ve satir filtrelemesiyle yapilir.
# Ikisi de bos birakilirsa uygulama "kimlik dogrulama yapilandirilmamis"
# ekranini gosterir.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
