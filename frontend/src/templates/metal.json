{
  "stations": [
    {
      "id": "kesme",
      "name": "Kesme",
      "num_servers": 2,
      "service_time_distribution": {
        "type": "triangular",
        "params": { "min": 2, "mode": 2.5, "max": 4 }
      },
      "buffer_capacity_before": -1,
      "scrap_rate": 0
    },
    {
      "id": "torna",
      "name": "Torna",
      "num_servers": 2,
      "service_time_distribution": {
        "type": "normal",
        "params": { "mean": 5, "std": 1.2 }
      },
      "buffer_capacity_before": -1,
      "scrap_rate": 0.04
    },
    {
      "id": "kaynak",
      "name": "Kaynak",
      "num_servers": 3,
      "service_time_distribution": {
        "type": "exponential",
        "params": { "mean": 6 }
      },
      "buffer_capacity_before": 10,
      "scrap_rate": 0
    },
    {
      "id": "boyama",
      "name": "Boyama",
      "num_servers": 1,
      "service_time_distribution": {
        "type": "constant",
        "params": { "value": 2.2 }
      },
      "buffer_capacity_before": -1,
      "scrap_rate": 0
    }
  ],
  "connections": [
    { "from_station_id": "kesme", "to_station_id": "torna", "routing_probability": 1 },
    { "from_station_id": "torna", "to_station_id": "kaynak", "routing_probability": 1 },
    { "from_station_id": "kaynak", "to_station_id": "boyama", "routing_probability": 1 }
  ],
  "arrival_process": {
    "distribution": { "type": "exponential", "params": { "mean": 3.2 } },
    "entry_station_id": "kesme"
  },
  "simulation_duration_minutes": 10000,
  "warmup_period_minutes": 500,
  "num_replications": 30,
  "random_seed": 42
}
