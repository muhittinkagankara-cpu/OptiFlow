{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "acceptance": "node scripts/acceptance.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:visual": "playwright test tests/visual.spec.ts",
    "test:a11y": "playwright test tests/a11y.spec.ts",
    "test:constitution": "vitest run src/lib/designSystem && playwright test tests/constitution.spec.ts tests/touch-targets.spec.ts",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.114.0",
    "lucide-react": "^1.40.0",
    "pdfmake": "^0.2.23",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "reactflow": "^11.11.4",
    "read-excel-file": "^9.3.10",
    "recharts": "^3.10.1",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "axe-core": "^4.13.0",
    "oxlint": "^1.79.0",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
