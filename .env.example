# OptiFlow uretim ayarlari — ornek.
#
# `cp .env.example .env` ile kopyalayip doldurun. `.env` surum kontrolune
# **girmez**; gizli bilgiler depo gecmisinde kalici olarak durmamalidir.

# --- Ortam ----------------------------------------------------------------
# "production" yazildiginda eksik ayarlar hata sayilir ve /api/ready 503 doner.
OPTIFLOW_ENV=production

# --- Veritabani -----------------------------------------------------------
POSTGRES_USER=optiflow
POSTGRES_PASSWORD=degistirin-guclu-bir-parola
POSTGRES_DB=optiflow

# --- Kimlik dogrulama (Supabase) ------------------------------------------
# JWKS adresi olmadan hicbir token dogrulanamaz; uretimde zorunludur.
SUPABASE_JWKS_URL=https://<proje>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated

# --- CORS -----------------------------------------------------------------
# Virgulle ayrilmis tam adresler. Joker (*) kabul edilmez: uretimde
# /api/ready bunu hata sayar.
FRONTEND_ORIGINS=https://optiflow.example.com

# --- Arayuz ---------------------------------------------------------------
VITE_API_BASE_URL=https://api.optiflow.example.com

# --- Portlar --------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=8080
